{
  "name": "@btoon/js",
  "version": "0.1.2",
  "description": "BTOON (Binary TOON) for JavaScript and TypeScript: canonical, hardened MessagePack with a columnar encoding for tables. Pure TypeScript, zero dependencies; runs in browsers, Node.js, Deno, Bun and edge runtimes.",
  "keywords": [
    "btoon",
    "messagepack",
    "msgpack",
    "binary",
    "serialization",
    "canonical",
    "tabular",
    "columnar",
    "browser",
    "deno",
    "bun"
  ],
  "homepage": "https://btoon.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BTOON-project/btoon-javascript.git"
  },
  "bugs": "https://github.com/BTOON-project/btoon-javascript/issues",
  "license": "MIT",
  "author": "BTOON Contributors",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "deno": {
        "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
        "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
      },
      "browser": {
        "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
        "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
      },
      "worker": {
        "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
        "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
      },
      "workerd": {
        "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
        "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
      },
      "edge-light": {
        "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
        "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
      },
      "react-native": {
        "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
        "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
      },
      "node": {
        "import": { "types": "./dist/esm/node.d.ts", "default": "./dist/esm/node.js" },
        "require": { "types": "./dist/cjs/node.d.ts", "default": "./dist/cjs/node.js" }
      },
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" },
      "default": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/tsc.mjs -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "bench": "node bench/bench.mjs",
    "vectors:sync": "node scripts/sync-vectors.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "~5.9.3"
  }
}
